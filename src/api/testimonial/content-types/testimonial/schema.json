{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Customer quotes shown on the site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "quote": {
      "type": "text",
      "required": true
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "authorRole": {
      "type": "string"
    },
    "authorLinkedIn": {
      "type": "string",
      "required": false
    },
    "companyName": {
      "type": "string"
    },
    "companyLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "order": {
      "type": "integer"
    }
  }
}
